#!/usr/bin/env python3
"""Guard only this migration branch's literal advertised update."""

import os
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
import repository


def main():
    hook = Path(__file__).absolute()
    relative = ".github/migration-hooks/pre-push"
    expected = repository.entries(repository.run("git", "ls-tree", "-z", "HEAD", "--", relative)).get(relative)
    if hook.is_symlink() or not hook.is_file() or not os.access(hook, os.X_OK):
        raise ValueError("migration guard must be a nonsymlink executable")
    if expected is None or expected[0] != "100755" or repository.actual_blob(hook) != expected:
        raise ValueError("migration guard must match its committed executable blob")
    head, old = os.environ["MIGRATION_HEAD"], os.environ["MIGRATION_OLD"]
    if not all(re.fullmatch(r"[0-9a-f]{40}", value) for value in (head, old)):
        raise ValueError("invalid expected migration SHA")
    repository.verify_checkout(head)
    message = repository.run("git", "log", "-1", "--format=%B", head).rstrip("\n")
    if message.rsplit("\n", 1)[-1] != (
        "Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>"
    ):
        raise ValueError("Migration commit requires literal ending co-author trailer")
    if sys.argv[1:] == ["--check"]:
        return
    records = sys.stdin.read().splitlines()
    if len(records) != 1 or records[0].split() != [
        head, head, "refs/heads/miyako-simplify-continuity-camera-workflows", old,
    ]:
        raise ValueError("expected exactly one literal advertised migration old/new update")
    if log := os.environ.get("MIGRATION_ADVERTISEMENT_LOG"):
        with open(log, "a", encoding="utf-8") as stream:
            stream.write(records[0] + "\n")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError) as error:
        print(f"Migration push stopped: {error}", file=sys.stderr)
        sys.exit(1)
